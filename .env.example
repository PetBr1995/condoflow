# ==========================================
# CondoFlow - Configurações de Ambiente (.env)
# ==========================================

# 1. Segurança do Django
# Gere uma chave aleatória para produção (ex: via python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=sua-chave-secreta-de-producao-gerada-aleatoriamente

# Em produção, NUNCA deixe DEBUG=True
DEBUG=False

# Domínios ou IPs que podem acessar a aplicação (separados por vírgula)
ALLOWED_HOSTS=api.condoflow.com.br,condoflow.com.br,seu-backend.onrender.com,localhost,127.0.0.1

# 2. Banco de Dados PostgreSQL de Produção
# Formato: postgres://USUARIO:SENHA@HOST:PORTA/NOME_BANCO
# No Render, Supabase ou Railway, essa variável é fornecida automaticamente como DATABASE_URL
DATABASE_URL=postgres://condoflow_user:senha_segura@localhost:5432/condoflow_prod

# 3. CORS (Segurança de acesso do Frontend ao Backend)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://app.condoflow.com.br,https://seu-frontend.onrender.com,http://localhost:4200

# 4. Armazenamento em Nuvem de Fotos & PDFs (Cloudinary)
# Gratuito até 25GB/mês. Obtenha no painel do Cloudinary (https://cloudinary.com):
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret
